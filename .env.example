# Runtime mode: auto | native | smos
GTD_MODE=auto

# Feature toggles: auto | 0 | 1
GTD_ENABLE_TERMINAL=auto
GTD_ENABLE_DELEGATION_EMAIL=auto

# Data locations (optional)
GTD_WORKFLOW_DIR=./sample-workflow
GTD_INBOX_FILE=./workflow-inbox.md

# ttyd settings (optional)
GTD_TTYD_PORT=7681
GTD_TTYD_BASE_PATH=/gtd-terminal
GTD_TTYD_FONT_SIZE=16
GTD_TTYD_LOG_FILE=./ttyd.log

# Delegation email over SMTP (optional)
GTD_SMTP_HOST=
GTD_SMTP_PORT=587
GTD_SMTP_USER=
GTD_SMTP_PASS=
GTD_SMTP_FROM=
GTD_SMTP_STARTTLS=1
